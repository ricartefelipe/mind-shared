# Modo IA local — LLM GGUF + embeddings neurais (sem Docker/Ollama)
export MIND_COMPOSER_BACKEND=local
export MIND_COMPOSER_GGUF=malha/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
export MIND_COMPOSER_TIMEOUT_SECONDS=120
export MIND_EMBEDDING_BACKEND=sentence
export MIND_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Opcional: Ollama em vez de GGUF local (descomente e comente MIND_COMPOSER_BACKEND=local)
